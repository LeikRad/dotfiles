# Kali Linux VM, provider: libvirt/KVM.
#
# Usage:
#   vagrant up              # create + boot (first run grows the disk, see note below)
#   vagrant ssh              # ssh in (or `virt-manager` for a GUI console)
#   vagrant halt             # shut down
#   vagrant destroy          # delete the VM entirely
#   vagrant snapshot save <name>     # e.g. "post-install", or a CVE id before an exploit
#   vagrant snapshot restore <name>
#   vagrant snapshot list

Vagrant.configure("2") do |config|
  config.vm.box = "kalilinux/rolling"

  config.vm.provider "libvirt" do |lv|
    lv.default_prefix = "kali-pentest"
    lv.memory = 12288
    lv.cpus = 4

    # Grows the virtual disk itself to 80GB (dynamically allocated, so it
    # only takes up real space on the host as data is written). This alone
    # does NOT grow the partition/filesystem inside the guest -- see the
    # provisioner below, which does that on first boot.
    lv.machine_virtual_size = 80

    # SPICE + virtio-gpu instead of the VNC/cirrus default. virtio-gpu (unlike
    # the legacy QXL device) has no fixed resolution table, so paired with
    # spice-vdagent in the guest (installed by the provisioner below) it
    # resizes to whatever arbitrary size the viewer window is -- the same
    # experience as VirtualBox's guest additions auto-resize.
    lv.graphics_type = "spice"
    lv.video_type = "virtio"
    lv.video_vram = 65536
    lv.channel :type => "spicevmc", :target_name => "com.redhat.spice.0", :target_type => "virtio"

    # Default input is a relative PS/2 mouse, which desyncs badly from the
    # click position on a scaled display. A USB tablet does absolute
    # positioning instead.
    lv.input :type => "tablet", :bus => "usb"
  end

  # Host-only network so the VM can reach the host/other VMs without being
  # exposed on the LAN.
  config.vm.network "private_network", type: "dhcp"

  # Runs once, on first `vagrant up`: installs the full desktop toolset,
  # then grows the root filesystem to fill the resized disk.
  config.vm.provision "shell", inline: <<-SHELL
    set -e
    apt-get update
    apt-get install -y kali-linux-headless cloud-guest-utils podman spice-vdagent
    systemctl enable --now spice-vdagentd

    root_src=$(findmnt -no SOURCE /)
    disk=$(lsblk -no pkname "$root_src")
    part_num=$(echo "$root_src" | grep -o '[0-9]*$')

    if [ -n "$disk" ] && [ -n "$part_num" ]; then
      growpart "/dev/$disk" "$part_num" || true
      resize2fs "$root_src" || xfs_growfs / || true
    else
      echo "Could not auto-detect disk layout -- grow the filesystem manually."
    fi
  SHELL
end
